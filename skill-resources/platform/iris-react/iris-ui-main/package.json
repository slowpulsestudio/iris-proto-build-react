{
  "name": "iris-ui-repo-root",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "components:build": "pnpm --filter @oneidentity/iris-ui build",
    "storybook:build": "ng run iris-ui:build-storybook",
    "storybook:start": "ng run iris-ui:storybook",
    "tokens:build": "pnpm --filter @oneidentity/iris-ui-tokens build",
    "tokens:publish": "pnpm --filter @oneidentity/iris-ui-tokens exec npm publish",
    "icons:build": "pnpm --filter @oneidentity/iris-ui-icons build",
    "icons:build:assets": "pnpm --filter @oneidentity/iris-ui-icons build:assets",
    "icons:publish": "pnpm --filter @oneidentity/iris-ui-icons exec npm publish",
    "test": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --code-coverage",
    "lint": "ng lint",
    "lint:autofix": "ng lint --fix",
    "postinstall": "pnpm run tokens:build && pnpm run icons:build && pnpm run components:build && pnpm run storybook:build"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.19",
    "@angular/compiler": "^20.3.19",
    "@angular/core": "^20.3.19",
    "@angular/forms": "^20.3.19",
    "@angular/platform-browser": "^20.3.19",
    "@angular/router": "^20.3.19",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@oneidentity/iris-ui-icons": "workspace:*",
    "ag-grid-angular": "^35.2.1",
    "ag-grid-community": "^35.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.24",
    "@angular/build": "^20.3.24",
    "@angular/cli": "^20.3.24",
    "@angular/compiler-cli": "^20.3.19",
    "@angular/platform-browser-dynamic": "^20.3.19",
    "@eslint/js": "^9.0.0",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/angular": "^10.3.5",
    "@tony.ganchev/eslint-plugin-header": "^3.4.4",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "3.2.4",
    "angular-eslint": "^20.7.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-storybook": "10.3.5",
    "ng-packagr": "^20.3.2",
    "prettier": "^3.8.3",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.3.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^3.2.4",
    "zone.js": "^0.15.0"
  }
}