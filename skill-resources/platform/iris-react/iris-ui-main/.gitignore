# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# ── Build output ──────────────────────────────────────────────────────────────
/out-tsc
/dist
/bazel-out
/storybook-static
*.log

# ── Dependencies ──────────────────────────────────────────────────────────────
/node_modules
Components/node_modules
Icons/node_modules
Tokens/node_modules

# ── Components package build output ───────────────────────────────────────────
Components/dist
Storybook/dist
Tokens/dist
Icons/dist
Icons/dist-assets

# ── Angular specific ──────────────────────────────────────────────────────────
/.angular

# ── Test & coverage ───────────────────────────────────────────────────────────
/coverage
__screenshots__/
testem.log

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*

# ── Local dev secrets (never commit) ─────────────────────────────────────────
.env*

# ── Publish auth files (npmAuthenticate injects a token at release time; must
#    stay untracked so `pnpm publish`'s git-clean check passes). Regenerated in
#    the release pipeline. Components/.npmrc is intentionally NOT ignored — it is
#    an ng-package asset copied into the (ignored) Components/dist/.npmrc. ──────
Tokens/.npmrc
Icons/.npmrc

# ── Temp / scratch ────────────────────────────────────────────────────────────
/tmp
/typings
/connect.lock
/libpeerconnection.log
/sass-cache

# ── Agent session context (generated by Agent Wrapper, not for source control) ─
/.agents
AGENTS.md

# ── IDEs and editors ──────────────────────────────────────────────────────────
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code — commit only shared config, never personal/secret files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
# ⚠️  mcp.json may contain PAT tokens — do not commit if it has secrets
.vscode/mcp.json

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
